 between Swift and C++.","type":"text"}],"kind":"article","url":"\/documentation\/project-operations\/cxx-interop-workgroup","identifier":"doc:\/\/project-operations\/documentation\/project-operations\/cxx-interop-workgroup","title":"C++ Interoperability Workgroup"},"https://forums.swift.org/new-message?username=jmschonfeld":{"identifier":"https:\/\/forums.swift.org\/new-message?username=jmschonfeld","title":"@jmschonfeld","url":"https:\/\/forums.swift.org\/new-message?username=jmschonfeld","titleInlineContent":[{"text":"@jmschonfeld","type":"text"}],"type":"link"},"https://github.com/swiftlang/swift-foundation/issues":{"url":"https:\/\/github.com\/swiftlang\/swift-foundation\/issues","type":"link","titleInlineContent":[{"text":"Github Issues","type":"text"}],"identifier":"https:\/\/github.com\/swiftlang\/swift-foundation\/issues","title":"Github Issues"},"https://forums.swift.org/new-message?username=Tony_Parker":{"type":"link","identifier":"https:\/\/forums.swift.org\/new-message?username=Tony_Parker","title":"@Tony_Parker","titleInlineContent":[{"text":"@Tony_Parker","type":"text"}],"url":"https:\/\/forums.swift.org\/new-message?username=Tony_Parker"},"doc://project-operations/documentation/project-operations":{"role":"collection","url":"\/documentation\/project-operations","title":"🏛️🤝 Swift Project Operations 🤝🏛️","identifier":"doc:\/\/project-operations\/documentation\/project-operations","abstract":[{"text":"This repository houses processes, policies, and procedures that relate to the operation of the Swift project.","type":"text"}],"kind":"article","type":"topic"},"doc://project-operations/documentation/project-operations/server-workgroup":{"url":"\/documentation\/project-operations\/server-workgroup","abstract":[{"type":"text","text":"The Swift Server workgroup is a steering team that promotes the use of Swift for developing and deploying server applications. The Swift Server workgroup will:"}],"identifier":"doc:\/\/project-operations\/documentation\/projec
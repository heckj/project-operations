":"topic","abstract":[{"type":"text","text":"The Swift website workgroup is a steering team that helps guide the evolution on the Swift.org website."}]},"doc://project-operations/documentation/project-operations/contributor-experience-workgroup":{"url":"\/documentation\/project-operations\/contributor-experience-workgroup","abstract":[{"type":"text","text":"The Contributor Experience Workgroup supports contributors to the Swift project, including contributions on the Swift Forums."}],"title":"Contributor Experience Workgroup","kind":"article","identifier":"doc:\/\/project-operations\/documentation\/project-operations\/contributor-experience-workgroup","type":"topic","role":"article"}}}
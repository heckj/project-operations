b Issues for tracking bugs."}],"url":"\/documentation\/project-operations\/reporting-bugs","type":"topic","kind":"article","role":"article","title":"Reporting Bugs","identifier":"doc:\/\/project-operations\/documentation\/project-operations\/reporting-bugs"},"doc://project-operations/documentation/project-operations/github-policies":{"abstract":[],"url":"\/documentation\/project-operations\/github-policies","kind":"article","type":"topic","role":"article","title":"Swiftlang GitHub Policies and Administration","identifier":"doc:\/\/project-operations\/documentation\/project-operations\/github-policies"},"https://www.swift.org/code-of-conduct/":{"type":"link","title":"Code of Conduct","titleInlineContent":[{"text":"Code of Conduct","type":"text"}],"url":"https:\/\/www.swift.org\/code-of-conduct\/","identifier":"https:\/\/www.swift.org\/code-of-conduct\/"},"doc://project-operations/documentation/project-operations/forums":{"role":"article","url":"\/documentation\/project-operations\/forums","title":"Swift Forums","identifier":"doc:\/\/project-operations\/documentation\/project-operations\/forums","abstract":[{"text":"Learn about the community channels for the Swift project.","type":"text"}],"kind":"article","type":"topic"},"doc://project-operations/documentation/project-operations/triaging-bugs":{"abstract":[{"text":"Reporting bugs is an important part of improving software.","type":"text"},{"type":"text","text":" "},{"text":"Nearly as important is triaging those bugs to ensure that they are reproducible, small, and unique.","type":"text"}],"kind":"article","type":"topic","url":"\/documentation\/project-operations\/triaging-bugs","role":"article","title":"Triaging Bugs","identifier":"doc:\/\/project-operations\/documentation\/project-operations\/triaging-bugs"},"doc://project-operations/documentation/project-operations":{"role":"collection","url":"\/documentation\/project-operations","title":"🏛️🤝 Swift Project Operations 🤝🏛️","identifier":"doc:\/\/project-operations\/documentation\/project-operations","abstract":[{"text":"This repository houses processes, policies, and procedures that relate to the operation of the Swift project.","type":"text"}],"kind":"article","type":"topic"},"doc://project-operations/documentation/project-operations/contributing-code":{"abstract":[],"url":"\/documentation\/project-operations\/contributing-code","type":"topic","kind":"article","role":"article","title":"Contributing Code","identifier":"doc:\/\/project-operations\/documentation\/project-operations\/contributing-code"}}}
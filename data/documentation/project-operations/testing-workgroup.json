{"abstract":[{"text":"The Testing Workgroup is a team that helps guide the experience, libraries, and","type":"text"},{"text":" ","type":"text"},{"text":"tools for testing Swift code.","type":"text"}],"identifier":{"url":"doc:\/\/project-operations\/documentation\/project-operations\/testing-workgroup","interfaceLanguage":"swift"},"sections":[],"metadata":{"role":"article","title":"Testing Workgroup","roleHeading":"Article"},"seeAlsoSections":[{"generated":true,"anchor":"Workgroups","title":"Workgroups","identifiers":["doc:\/\/project-operations\/documentation\/project-operations\/android-workgroup","doc:\/\/project-operations\/documentation\/project-operations\/build-and-packaging-workgroup","doc:\/\/project-operations\/documentation\/project-operations\/cxx-interop-workgroup","doc:\/\/project-operations\/documentation\/project-operations\/contributor-experience-workgroup","doc:\/\/project-operations\/documentation\/project-operations\/documentation-workgroup","doc:\/\/project-operations\/documentation\/project-operations\/foundation-workgroup","doc:\/\/project-operations\/documentation\/project-operations\/server-workgroup","doc:\/\/project-operations\/documentation\/project-operations\/website-workgroup","doc:\/\/project-operations\/documentation\/project-operations\/windows-workgroup"]}],"hierarchy":{"paths":[["doc:\/\/project-operations\/documentation\/project-operations","doc:\/\/project-operations\/documentation\/project-operations\/swift-groups"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"article","primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"text":"The Testing Workgroup will:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Govern the ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift-testing","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift-corelibs-xctest","isActive":true},{"text":" projects","type":"text"},{"text":" ","type":"text"},{"text":"and conduct reviews of their feature proposals.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Identify improvements which would address the needs of testing in the Swift","type":"text"},{"text":" ","type":"text"},{"text":"community.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Pursue long-term feature directions outlined in the Swift Testing","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift-evolution\/blob\/main\/visions\/swift-testing.md","isActive":true},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Promote the integration of testing functionality and libraries in related","type":"text"},{"text":" ","type":"text"},{"text":"tools.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Channel feedback to other workgroups, steering groups, and the Core Team about","type":"text"},{"text":" ","type":"text"},{"text":"unmet testing needs of the Swift community.","type":"text"}]}]}]},{"inlineContent":[{"text":"The current Testing Workgroup consists of the following people:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Brandon Williams (","type":"text"},{"type":"reference","identifier":"https:\/\/forums.swift.org\/new-message?username=mbrandonw","isActive":true},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Brian Croom (","type":"text"},{"type":"reference","identifier":"https:\/\/forums.swift.org\/new-message?username=briancroom","isActive":true},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Jonathan Grynspan (","type":"text"},{"type":"reference","identifier":"https:\/\/forums.swift.org\/new-message?username=grynspan","isActive":true},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Maarten Engels (","type":"text"},{"type":"reference","identifier":"https:\/\/forums.swift.org\/new-message?username=maartene","isActive":true},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Paul LeMarquand (","type":"text"},{"type":"reference","identifier":"https:\/\/forums.swift.org\/new-message?username=plemarquand","isActive":true},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Rachel Brindle (","type":"text"},{"type":"reference","identifier":"https:\/\/forums.swift.org\/new-message?username=younata","isActive":true},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Stuart Montgomery, Chair (","type":"text"},{"type":"reference","identifier":"https:\/\/forums.swift.org\/new-message?username=smontgomery","isActive":true},{"text":")","type":"text"}]}]}]},{"level":2,"text":"Charter","type":"heading","anchor":"Charter"},{"inlineContent":[{"text":"The ultimate goal of the Testing Workgroup is to enhance the experience and","type":"text"},{"text":" ","type":"text"},{"text":"utility of authoring and running tests in Swift to improve software quality","type":"text"},{"text":" ","type":"text"},{"text":"across the ecosystem. In pursuit of that goal, the workgroup develops libraries","type":"text"},{"text":" ","type":"text"},{"text":"like Swift Testing which implement core functionality needed by the community;","type":"text"},{"text":" ","type":"text"},{"text":"it coordinates with the maintainers of commonly-used tools, IDEs, and CI","type":"text"},{"text":" ","type":"text"},{"text":"systems to integrate them and promote testing workflows; and when necessary, it","type":"text"},{"text":" ","type":"text"},{"text":"collaborates with other Swift community groups to pursue testing-related","type":"text"},{"text":" ","type":"text"},{"text":"improvements in their areas. Some areas of frequent collaboration with other","type":"text"},{"text":" ","type":"text"},{"text":"groups include:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"the ","type":"text"},{"type":"codeVoice","code":"swift test"},{"text":" subcommand of","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift-package-manager","isActive":true},{"text":";","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the testing subsystem in the","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/vscode-swift","isActive":true},{"text":" plugin; and","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the static test discovery logic in","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/sourcekit-lsp","isActive":true},{"text":".","type":"text"}]}]}]},{"inlineContent":[{"text":"A central function of the workgroup is conducting community reviews of features","type":"text"},{"text":" ","type":"text"},{"text":"and API proposals for the Swift Testing project. Its governance of that project","type":"text"},{"text":" ","type":"text"},{"text":"is guided by its accompanying","type":"text"},{"text":" ","type":"text"},{"isActive":true,"overridingTitle":"vision document","identifier":"https:\/\/github.com\/swiftlang\/swift-evolution\/blob\/main\/visions\/swift-testing.md","type":"reference","overridingTitleInlineContent":[{"type":"text","text":"vision document"}]},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The workgroup also looks for opportunities to deepen integration of testing","type":"text"},{"text":" ","type":"text"},{"text":"libraries with tools and IDEs, enable additional styles of testing (such as","type":"text"},{"text":" ","type":"text"},{"text":"performance or UI), or to resolve problems which impact testing workflows.","type":"text"},{"text":" ","type":"text"},{"text":"Members of the workgroup regularly evaluate emerging trends in the Swift","type":"text"},{"text":" ","type":"text"},{"text":"ecosystem, and discuss how testing could better support them.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Membership","type":"heading","anchor":"Membership"},{"inlineContent":[{"text":"Membership in the Testing Workgroup is contribution-based and expected to","type":"text"},{"text":" ","type":"text"},{"text":"evolve over time. Adding new members and removing inactive ones is subject to a","type":"text"},{"text":" ","type":"text"},{"text":"vote by the existing members and requires unanimous agreement. Membership is","type":"text"},{"text":" ","type":"text"},{"text":"limited to ten members in total to keep the group small enough to be effective.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The Core Team selects one member of the workgroup as the chair. The chair has no","type":"text"},{"text":" ","type":"text"},{"text":"special authority over the workgroup, but they are responsible for ensuring its","type":"text"},{"text":" ","type":"text"},{"text":"smooth functioning, including by:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"organizing and leading regular meetings,","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"ensuring that the workgroup communicates effectively with the community, and","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"coordinating meetings between workgroup representatives and other Swift","type":"text"},{"text":" ","type":"text"},{"text":"workgroups or teams when necessary.","type":"text"}]}]}]},{"inlineContent":[{"text":"If you’d like to join the workgroup, send a message to","type":"text"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/forums.swift.org\/new-message?groupname=testing-workgroup"},{"type":"text","text":" "},{"type":"text","text":"on the Forums and you will be invited to the next available group meeting to"},{"type":"text","text":" "},{"type":"text","text":"discuss it more. See "},{"type":"reference","isActive":true,"identifier":"#community-participation"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"examples of ways to contribute and demonstrate your interest to the group."}],"type":"paragraph"},{"inlineContent":[{"text":"Workgroup members will try to make a decision independently by consensus","type":"text"},{"text":" ","type":"text"},{"text":"whenever possible, and will raise issues to the Core Team when there are","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"particular challenges with reaching consensus on significant decisions."}],"type":"paragraph"},{"level":2,"text":"Meetings","type":"heading","anchor":"Meetings"},{"inlineContent":[{"text":"The Testing Workgroup meets biweekly on Monday at 1:05PM PT (USA Pacific).","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Meetings take place in "},{"type":"reference","isActive":true,"identifier":"http:\/\/www.whatweekisit.org\/"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"unless otherwise communicated in advance."}],"type":"paragraph"},{"inlineContent":[{"text":"Many workgroup meetings are meant for open discussion and any Swift community","type":"text"},{"text":" ","type":"text"},{"text":"member may attend by sending a message to","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"https:\/\/forums.swift.org\/new-message?groupname=testing-workgroup","isActive":true,"overridingTitle":"@testing-workgroup","overridingTitleInlineContent":[{"text":"@testing-workgroup","type":"text"}]},{"text":" ","type":"text"},{"text":"beforehand to request an invite. Some meetings are reserved for private","type":"text"},{"text":" ","type":"text"},{"text":"discussion by group members, for example to make a decision on a proposal under","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"review."}],"type":"paragraph"},{"text":"Communication","level":2,"type":"heading","anchor":"Communication"},{"inlineContent":[{"type":"text","text":"The Testing Workgroup communicates with the broader Swift community in the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/forums.swift.org\/c\/development\/swift-testing\/103"},{"text":" ","type":"text"},{"text":"Forum category. The workgroup can also be contacted privately by sending a","type":"text"},{"text":" ","type":"text"},{"text":"message to","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"https:\/\/forums.swift.org\/new-message?groupname=testing-workgroup","isActive":true,"overridingTitle":"@testing-workgroup","overridingTitleInlineContent":[{"type":"text","text":"@testing-workgroup"}]},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If any significant decisions are reached during one of the workgroup’s regular","type":"text"},{"text":" ","type":"text"},{"text":"meetings, a member will post about them in the Forums within one week. The","type":"text"},{"text":" ","type":"text"},{"text":"outcome of each proposal review will be announced by its review manager in a","type":"text"},{"text":" ","type":"text"},{"text":"separate thread dedicated to that proposal.","type":"text"}],"type":"paragraph"},{"text":"Community participation","level":2,"type":"heading","anchor":"Community-participation"},{"inlineContent":[{"type":"text","text":"Everyone is invited to help improve Swift’s testing experience and participate"},{"type":"text","text":" "},{"type":"text","text":"in the Testing Workgroup’s initiatives. Here are some ways to consider"},{"type":"text","text":" "},{"type":"text","text":"participating:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Discuss ideas on the Swift Forums. You can create new topics in the"},{"type":"text","text":" "},{"overridingTitle":"swift-testing","type":"reference","isActive":true,"overridingTitleInlineContent":[{"text":"swift-testing","type":"text"}],"identifier":"https:\/\/forums.swift.org\/c\/development\/swift-testing\/103"},{"type":"text","text":" "},{"type":"text","text":"category, or add the "},{"type":"codeVoice","code":"testing"},{"type":"text","text":" tag to any topic."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Open GitHub issues to track enhancements or report bugs in the projects"},{"type":"text","text":" "},{"type":"text","text":"governed by the Testing Workgroup, such as"},{"type":"text","text":" "},{"overridingTitle":"swift-testing","type":"reference","isActive":true,"overridingTitleInlineContent":[{"text":"swift-testing","type":"text"}],"identifier":"https:\/\/github.com\/swiftlang\/swift-testing"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Contribute bug fixes or enhancements to"},{"type":"text","text":" "},{"overridingTitle":"swift-testing","type":"reference","isActive":true,"overridingTitleInlineContent":[{"text":"swift-testing","type":"text"}],"identifier":"https:\/\/github.com\/swiftlang\/swift-testing"},{"type":"text","text":". (See"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/swiftlang\/swift-testing\/blob\/main\/CONTRIBUTING.md"},{"type":"text","text":".)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Expand "},{"overridingTitle":"swift-testing","type":"reference","isActive":true,"overridingTitleInlineContent":[{"text":"swift-testing","type":"text"}],"identifier":"https:\/\/github.com\/swiftlang\/swift-testing"},{"type":"text","text":" to support"},{"type":"text","text":" "},{"type":"text","text":"additional platforms. (See"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/swiftlang\/swift-testing\/blob\/main\/Documentation\/Porting.md"},{"type":"text","text":".)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Develop new tools to aide automated testing or improve existing ones."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Provide feedback to the members of the Testing Workgroup directly by sending a"},{"type":"text","text":" "},{"type":"text","text":"message to"},{"type":"text","text":" "},{"overridingTitle":"@testing-workgroup","type":"reference","isActive":true,"overridingTitleInlineContent":[{"text":"@testing-workgroup","type":"text"}],"identifier":"https:\/\/forums.swift.org\/new-message?groupname=testing-workgroup"},{"type":"text","text":" "},{"type":"text","text":"on the Forums. The workgroup chair brings outstanding issues and topics to the"},{"type":"text","text":" "},{"type":"text","text":"workgroup to discuss during regular meetings. The workgroup decides the"},{"type":"text","text":" "},{"type":"text","text":"actions for the issues."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Join the Testing Workgroup’s regular video meetings. Send a message to"},{"type":"text","text":" "},{"overridingTitle":"@testing-workgroup","type":"reference","isActive":true,"overridingTitleInlineContent":[{"text":"@testing-workgroup","type":"text"}],"identifier":"https:\/\/forums.swift.org\/new-message?groupname=testing-workgroup"},{"type":"text","text":" "},{"type":"text","text":"to request access, since calls must be kept to a relatively small number of"},{"type":"text","text":" "},{"type":"text","text":"participants."}]}]}]}],"kind":"content"}],"references":{"https://github.com/swiftlang/
"kind":"article","identifier":"doc:\/\/project-operations\/documentation\/project-operations\/documentation-workgroup","abstract":[{"type":"text","text":"The Documentation Tooling Workgroup is a steering team that helps guide the"},{"text":" ","type":"text"},{"type":"text","text":"documentation experience for Swift."}],"type":"topic","url":"\/documentation\/project-operations\/documentation-workgroup"},"https://forums.swift.org/u/Joannis_Orlandos/summary":{"title":"@Joannis_Orlandos","titleInlineContent":[{"type":"text","text":"@Joannis_Orlandos"}],"type":"link","identifier":"https:\/\/forums.swift.org\/u\/Joannis_Orlandos\/summary","url":"https:\/\/forums.swift.org\/u\/Joannis_Orlandos\/summary"},"https://forums.swift.org/u/marcprux/summary":{"title":"@marcprux","titleInlineContent":[{"type":"text","text":"@marcprux"}],"type":"link","identifier":"https:\/\/forums.swift.org\/u\/marcprux\/summary","url":"https:\/\/forums.swift.org\/u\/marcprux\/summary"},"https://forums.swift.org/u/lukeh/summary":{"type":"link","url":"https:\/\/forums.swift.org\/u\/lukeh\/summary","identifier":"https:\/\/forums.swift.org\/u\/lukeh\/summary","title":"@lukeh","titleInlineContent":[{"text":"@lukeh","type":"text"}]},"https://www.swift.org/documentation/continuous-integration/":{"title":"continuous integration","titleInlineContent":[{"type":"text","text":"continuous integration"}],"type":"link","identifier":"https:\/\/www.swift.org\/documentation\/continuous-integration\/","url":"https:\/\/www.swift.org\/documentation\/continuous-integration\/"}}}
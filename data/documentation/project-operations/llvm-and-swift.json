{"metadata":{"roleHeading":"Article","role":"article","title":"LLVM and Swift"},"hierarchy":{"paths":[["doc:\/\/project-operations\/documentation\/project-operations","doc:\/\/project-operations\/documentation\/project-operations\/contributing-to-swift"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/project-operations\/documentation\/project-operations\/llvm-and-swift"},"sections":[],"kind":"article","abstract":[{"type":"text","text":"Understand the relationship between Swift and LLVM."}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift is built on the "},{"type":"reference","isActive":true,"identifier":"http:\/\/llvm.org\/"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Swift uses the LLVM Core for code generation and optimization (among other things), "},{"type":"reference","isActive":true,"identifier":"http:\/\/clang.llvm.org\/"},{"type":"text","text":" for interoperability with C-based languages, and "},{"type":"reference","isActive":true,"identifier":"http:\/\/lldb.llvm.org\/"},{"type":"text","text":" for debugging and the REPL."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift maintains a fork of the "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/llvm\/llvm-project"},{"type":"text","text":" source repository on GitHub at "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/swiftlang\/llvm-project"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This repository tracks upstream LLVM development and contains additional changes for Swift."},{"type":"text","text":" "},{"type":"text","text":"The upstream LLVM repositories are merged into the Swift-specific repository frequently."},{"type":"text","text":" "},{"type":"text","text":"Every attempt is made to minimize the differences between upstream LLVM and the Swift fork to only those changes specifically required for Swift."}]},{"level":3,"anchor":"Where-Do-LLVM-Changes-Go","type":"heading","text":"Where Do LLVM Changes Go?"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift follows a policy of making a change in the most upstream repository that is feasible."},{"type":"text","text":" "},{"type":"text","text":"Contributions to Swift’s version of the LLVM Project should go directly into the upstream LLVM repository unless they are specific to Swift."},{"type":"text","text":" "},{"type":"text","text":"For example, an improvement to LLDB’s data formatters for a Swift type belongs in the Swift fork of the LLVM project, whereas a bug fix to an LLVM optimizer—even if it’s only been observed when operating on Swift-generated LLVM IR—belongs in upstream LLVM."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Commits to an upstream LLVM repository are automatically merged into the appropriate upstream branches in the corresponding Swift repository ("},{"type":"codeVoice","code":"next"},{"type":"text","text":") in the "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/swiftlang\/llvm-project","overridingTitle":"llvm-project","overridingTitleInlineContent":[{"text":"llvm-project","type":"text"}]},{"type":"text","text":"."}]},{"level":3,"anchor":"Swift-and-LLVM-Developer-Policies","type":"heading","text":"Swift and LLVM Developer Policies"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Contributions to the "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/swiftlang\/llvm-project","overridingTitle":"llvm-project clone","overridingTitleInlineContent":[{"text":"llvm-project clone","type":"text"}]},{"type":"text","text":" are governed by the "},{"type":"reference","isActive":true,"identifier":"http:\/\/llvm.org\/docs\/DeveloperPolicy.html"},{"type":"text","text":" and should follow the appropriate "},{"type":"reference","isActive":true,"identifier":"http:\/\/llvm.org\/docs\/DeveloperPolicy.html#copyright-license-and-patents"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"http:\/\/llvm.org\/docs\/CodingStandards.html"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Issues with LLVM code are tracked using the "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/llvm\/llvm-project\/issues"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"For LLDB, changes to files with llvm.org comment headers must go to the "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/llvm\/llvm-project\/tree\/main\/lldb"},{"type":"text","text":" and abide by the "},{"type":"reference","isActive":true,"identifier":"http:\/\/llvm.org\/docs\/DeveloperPolicy.html","overridingTitle":"LLVM Developer Policy","overridingTitleInlineContent":[{"text":"LLVM Developer Policy","type":"text"}]},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"https:\/\/llvm.org\/docs\/CodingStandards.html"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Contributions to the Swift-specific parts of LLDB (that is, those with a Swift.org comment header) use the "},{"type":"reference","isActive":true,"identifier":"https:\/\/www.swift.org\/community\/#license"},{"type":"text","text":" but still follow the LLDB coding conventions."}]}]}],"references":{"https://www.swift.org/community/#license":{"type":"link","titleInlineContent":[{"type":"text","text":"Swift license"}],"title":"Swift license","url":"https:\/\/www.swift.org\/community\/#license","identifier":"https:\/\/www.swift.org\/community\/#license"},"http://lldb.llvm.org/":{"type":"link","titleInlineContent":[{"type":"text","text":"LLDB"}],"title":"LLDB","url":"http:\/\/lldb.llvm.org\/","identifier":"http:\/\/lldb.llvm.org\/"},"https://llvm.org/docs/CodingStandards.html":{"type":"link","titleInlineContent":[{"type":"text","text":"LLDB coding conventions"}],"title":"LLDB coding conventions","url":"https:\/\/llvm.org\/docs\/CodingStandards.html","identifier":"https:\/\/llvm.org\/docs\/CodingStandards.html"},"http://llvm.org/docs/DeveloperPolicy.html#copyright-license-and-patents":{"type":"link","titleInlineContent":[{"type":"text","text":"licensing"}],"title":"licensing","url":"http:\/\/llvm.org\/docs\/DeveloperPolicy.html#copyright-license-and-patents","identifier":"http:\/\/llvm.org\/docs\/DeveloperPolicy.html#copyright-license-and-patents"},"http://llvm.org/":{"type":"link","titleInlineContent":[{"type":"text","text":"LLVM Compiler Infrastructure"}],"title":"LLVM Compiler Infrastructure","url":"http:\/\/llvm.org\/","identifier":"http:\/\/llvm.org\/"},"https://github.com/llvm/llvm-project/issues":{"type":"link","titleInlineContent":[{"type":"text","text":"LLVM bug database"}],"title":"LLVM bug database","url":"https:\/\/github.com\/llvm\/llvm-project\/issues","identifier":"https:\/\/github.com\/llvm\/llvm-project\/issues"},"doc://project-operations/documentation/project-operations/contributing-to-swift":{"role":"collectionGroup","url":"\/documentation\/project-operations\/contributing-to-swift","title":"Contributing to Swift","identifier":"doc:\/\/project-operations\/documentation\/project-operations\/contributing-to-swift","abstract":[{"text":"The Swift.org community has the singular goal of making the world’s best general purpose programming language. Collectively we will develop the language in the open, with contributions from anyone who wishes to participate. This guideline document describes how the Swift community is organized so that we can work together to add amazing new capabilities to Swift, and make it available to even more developers across more platforms.","type":"text"}],"kind":"article","type":"topic"},"http://clang.llvm.org/":{"type":"link","titleInlineContent":[{"type":"text","text":"Clang"}],"title":"Clang","url":"http:\/\/clang.llvm.org\/","identifier":"http:\/\/clang.llvm.org\/"},"https://github.com/llvm/llvm-project":{"type":"link","titleInlineContent":[{"type":"text","text":"LLVM Core"}],"title":"LLVM Core","url":"https:\/\/github.com\/llvm\/llvm-project","identifier":"https:\/\/github.com\/llvm\/llvm-project"},"https://github.com/swiftlang/llvm-project":{"type":"link","titleInlineContent":[{"type":"text","text":"llvm-project"}],"title":"llvm-project","url":"https:\/\/github.com\/swiftlang\/llvm-project","identifier":"https:\/\/github.com\/swiftlang\/llvm-project"},"http://llvm.org/docs/DeveloperPolicy.html":{"type":"link","titleInlineContent":[{"type":"text","text":"LLVM Developer Policy"}],"title":"LLVM Developer Policy","url":"http:\/\/llvm.org\/docs\/DeveloperPolicy.html","identifier":"http:\/\/llvm.org\/docs\/DeveloperPolicy.html"},"doc://project-operations/documentation/project-operations":{"role":"collection","url":"\/documentation\/project-operations","title":"🏛️🤝 Swift Project Operations 🤝🏛️","identifier":"doc:\/\/project-operations\/documentation\/project-operations","abstract":[{"text":"This repository houses processes, policies, and procedures that relate to the operation of the Swift project.","type":"text"}],"kind":"article","type":"topic"},"https://github.com/llvm/llvm-project/tree/main/lldb":{"type":"link","titleInlineContent":[{"type":"text","text":"upstream LLDB at llvm.org"}],"title":"upstream LLDB at llvm.org","url":"https:\/\/github.com\/llvm\/llvm-project\/tree\/main\/lldb","identifier":"https:\/\/github.com\/llvm\/llvm-project\/tree\/main\/lldb"},"http://llvm.org/docs/CodingStandards.html":{"type":"link","titleInlineContent":[{"type":"text","text":"coding standards"}],"title":"coding standards","url":"http:\/\/llvm.org\/docs\/CodingStandards.html","identifier":"http:\/\/llvm.org\/docs\/CodingStandards.html"}}}
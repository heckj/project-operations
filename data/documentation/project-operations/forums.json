ect Operations 🤝🏛️","identifier":"doc:\/\/project-operations\/documentation\/project-operations","abstract":[{"text":"This repository houses processes, policies, and procedures that relate to the operation of the Swift project.","type":"text"}],"kind":"article","type":"topic"},"https://forums.swift.org/c/evolution/announce":{"url":"https:\/\/forums.swift.org\/c\/evolution\/announce","identifier":"https:\/\/forums.swift.org\/c\/evolution\/announce","type":"link","titleInlineContent":[{"text":"Announcements","type":"text"}],"title":"Announcements"},"http://forums.swift.org/c/development/SwiftPM":{"url":"http:\/\/forums.swift.org\/c\/development\/SwiftPM","identifier":"http:\/\/forums.swift.org\/c\/development\/SwiftPM","type":"link","titleInlineContent":[{"text":"Package Manager","type":"text"}],"title":"Package Manager"},"https://forums.swift.org":{"type":"link","title":"forums","titleInlineContent":[{"text":"forums","type":"text"}],"url":"https:\/\/forums.swift.org","identifier":"https:\/\/forums.swift.org"},"doc://project-operations/documentation/project-operations/good-first-issues":{"abstract":[{"type":"text","text":"Understand identifying introductory issues that are good starting points for developers new to contributing to Swift."}],"kind":"article","url":"\/documentation\/project-operations\/good-first-issues","type":"topic","role":"article","title":"Good First Issues","identifier":"doc:\/\/project-operations\/documentation\/project-operations\/good-first-issues"},"doc://project-operations/documentation/project-operations/triaging-bugs":{"abstract":[{"text":"Reporting bugs is an important part of improving software.","type":"text"},{"type":"text","text":" "},{"text":"Nearly as important is triaging those bugs to ensure that they are reproducible, small, and unique.","type":"text"}],"kind":"article","type":"topic","url":"\/documentation\/project-operations\/triaging-bugs","role":"article","title":"Triaging Bugs","identifier":"doc:\/\/project-operations\/documentation\/project-operations\/triaging-bugs"},"doc://project-operations/documentation/project-operations/contributing-to-swift":{"role":"collectionGroup","url":"\/documentation\/project-operations\/contributing-to-swift","title":"Contributing to Swift","identifier":"doc:\/\/project-operations\/documentation\/project-operations\/contributing-to-swift","abstract":[{"text":"The Swift.org community has the singular goal of making the world’s best general purpose programming language. Collectively we will develop the language in the open, with contributions from anyone who wishes to participate. This guideline document describes how the Swift community is organized so that we can work together to add amazing new capabilities to Swift, and make it available to even more developers across more platforms.","type":"text"}],"kind":"article","type":"topic"},"http://forums.swift.org/c/development/corelibs":{"type":"link","title":"Core Libraries","titleInlineContent":[{"type":"text","text":"Core Libraries"}],"url":"http:\/\/forums.swift.org\/c\/development\/corelibs","identifier":"http:\/\/forums.swift.org\/c\/development\/corelibs"},"https://forums.swift.org/c/general-announce":{"url":"https:\/\/forums.swift.org\/c\/general-announce","identifier":"https:\/\/forums.swift.org\/c\/general-announce","type":"link","titleInlineContent":[{"type":"text","text":"Announcements"}],"title":"Announcements"},"https://forums.swift.org/c/evolution/proposal-reviews":{"url":"https:\/\/forums.swift.org\/c\/evolution\/proposal-reviews","type":"link","titleInlineContent":[{"type":"text","text":"Proposal Reviews"}],"identifier":"https:\/\/forums.swift.org\/c\/evolution\/proposal-reviews","title":"Proposal Reviews"},"doc://project-operations/documentation/project-operations/contributor-ladder":{"role":"article","url":"\/documentation\/project-operations\/contributor-ladder","title":"Contributor Ladder","identifier":"doc:\/\/project-operations\/documentation\/project-operations\/contributor-ladder","abstract":[{"type":"text","text":"This contributor ladder defines the roles you might gain while contributing to Swift on GitHub. Each role has privileges associated, which requires building trust with the community of contributors. We recognize there are many different types of contributors to Swift and we appreciate every single one! Everyone who has participated in the open source Swift project is a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Contributor"}]},{"type":"text","text":": This can be by writing code, answering questions on the forums, reporting or triaging bugs, or participating in the Swift evolution process."}],"kind":"article","type":"topic"},"doc://project-operations/documentation/project-operations/swift-evolution":{"role":"article","url":"\/documentation\/project-operations\/swift-evolution","title":"Swift Evolution","identifier":"doc:\/\/project-operations\/documentation\/project-operations\/swift-evolution","kind":"article","abstract":[{"type":"text","text":"Understand the process the Swift project uses to evolve the language."}],"type":"topic"},"https://forums.swift.org/c/community-showcase":{"url":"https:\/\/forums.swift.org\/c\/community-showcase","type":"link","titleInlineContent":[{"text":"Community Showcase","type":"text"}],"identifier":"https:\/\/forums.swift.org\/c\/community-showcase","title":"Community Showcase"},"http://forums.swift.org/c/development/stdlib":{"type":"link","title":"Standard Library","titleInlineContent":[{"text":"Standard Library","type":"text"}],"url":"http:\/\/forums.swift.org\/c\/development\/stdlib","identifier":"http:\/\/forums.swift.org\/c\/development\/stdlib"},"http://forums.swift.org/c/development/ci-notifications":{"url":"http:\/\/forums.swift.org\/c\/development\/ci-notifications","type":"link","titleInlineContent":[{"text":"CI Notifications","type":"text"}],"identifier":"http:\/\/forums.swift.org\/c\/development\/ci-notifications","title":"CI Notifications"},"http://forums.swift.org/c/deve
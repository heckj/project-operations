{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/project-operations\/documentation\/project-operations\/build-and-packaging-workgroup"},"sections":[],"metadata":{"roleHeading":"Article","role":"article","title":"Build and Packaging Workgroup"},"seeAlsoSections":[{"anchor":"Workgroups","title":"Workgroups","identifiers":["doc:\/\/project-operations\/documentation\/project-operations\/android-workgroup","doc:\/\/project-operations\/documentation\/project-operations\/cxx-interop-workgroup","doc:\/\/project-operations\/documentation\/project-operations\/contributor-experience-workgroup","doc:\/\/project-operations\/documentation\/project-operations\/documentation-workgroup","doc:\/\/project-operations\/documentation\/project-operations\/foundation-workgroup","doc:\/\/project-operations\/documentation\/project-operations\/server-workgroup","doc:\/\/project-operations\/documentation\/project-operations\/testing-workgroup","doc:\/\/project-operations\/documentation\/project-operations\/website-workgroup","doc:\/\/project-operations\/documentation\/project-operations\/windows-workgroup"],"generated":true}],"hierarchy":{"paths":[["doc:\/\/project-operations\/documentation\/project-operations","doc:\/\/project-operations\/documentation\/project-operations\/swift-groups"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"text":"Charter","type":"heading","level":2,"anchor":"Charter"},{"type":"paragraph","inlineContent":[{"text":"The Build and Packaging Workgroup is a team that represents the build and packaging community in the Swift ecosystem.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Build and Packaging Workgroup will:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Support and guide efforts that address the build and packaging needs of the Swift community"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Actively guide development of the flagship build and packaging tooling that is included within the Swift project, such as the "},{"identifier":"https:\/\/github.com\/swiftlang\/swift-package-manager","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"https:\/\/github.com\/swiftlang\/swift-build","isActive":true,"type":"reference"},{"text":", and ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift-llbuild"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Plan and guide improvements to package dependency resolution","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Encourage development of Swift integrations in existing build and packaging systems that are outside of the Swift project (e.g. CMake, Bazel)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Encourage development of build tooling for cross-platform installation and deployment of packages","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Enable the growth of a cohesive Swift package ecosystem through improved tooling","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Channel feedback to the "},{"isActive":true,"identifier":"https:\/\/www.swift.org\/ecosystem-steering-group","type":"reference"},{"text":" about the needs of the Swift community.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Regularly update the Swift community on the status of ongoing build and packaging efforts","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Current Members of the Build and Packaging Workgroup are:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Dave Verwer, Swift Package Index (","type":"text"},{"type":"reference","identifier":"https:\/\/forums.swift.org\/u\/daveverwer\/summary","isActive":true},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Doug Schaefer, Apple (","type":"text"},{"type":"reference","identifier":"https:\/\/forums.swift.org\/u\/dschaefer2\/summary","isActive":true},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Evan Wilde, Apple ("},{"isActive":true,"identifier":"https:\/\/forums.swift.org\/u\/etcwilde\/summary","type":"reference"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Joannis Orlandos (","type":"text"},{"identifier":"https:\/\/forums.swift.org\/u\/Joannis_Orlandos\/summary","type":"reference","isActive":true},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Owen Voorhees, Apple, Chair (","type":"text"},{"identifier":"https:\/\/forums.swift.org\/u\/owenv\/summary","isActive":true,"type":"reference"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Sven A. Schmidt, Swift Package Index ("},{"type":"reference","isActive":true,"identifier":"https:\/\/forums.swift.org\/u\/finestructure\/summary"},{"text":")","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Tracy Miranda, Apple (","type":"text"},{"isActive":true,"identifier":"https:\/\/forums.swift.org\/u\/tracymiranda\/summary","type":"reference"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yuta Saito, Goodnotes ("},{"identifier":"https:\/\/forums.swift.org\/u\/kateinoigakukun\/summary","type":"reference","isActive":true},{"type":"text","text":")"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The main goal of the Build and Packaging Workgroup is to deliver a great build and packaging experience for the Swift community. To that end, the workgroup will develop tooling like the "},{"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift-package-manager","overridingTitleInlineContent":[{"type":"text","text":"Swift Package Manager"}],"isActive":true,"overridingTitle":"Swift Package Manager"},{"text":", ","type":"text"},{"type":"reference","overridingTitle":"Swift Build","isActive":true,"overridingTitleInlineContent":[{"text":"Swift Build","type":"text"}],"identifier":"https:\/\/github.com\/swiftlang\/swift-build"},{"text":", and ","type":"text"},{"identifier":"https:\/\/github.com\/swiftlang\/swift-llbuild","isActive":true,"type":"reference","overridingTitle":"llbuild","overridingTitleInlineContent":[{"text":"llbuild","type":"text"}]},{"text":", collaborate with other Swift community groups in areas which intersect with builds and packaging, work with the community to support tooling outside the Swift project, and provide feedback on relevant evolution pitches and proposals.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Members of the Build and Packaging Workgroup serve at the discretion of the ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/www.swift.org\/ecosystem-steering-group","overridingTitle":"Ecosystem Steering Group","overridingTitleInlineContent":[{"type":"text","text":"Ecosystem Steering Group"}]},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When necessary, the working group collaborates with other Swift community groups to pursue related improvements in their areas. Some areas of frequent collaboration with other groups and maintainers include:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The swift test subcommand of swift-package-manager with the "},{"identifier":"https:\/\/www.swift.org\/testing-workgroup","isActive":true,"type":"reference"}]}]},{"content":[{"inlineContent":[{"text":"Build system\/editor integration in ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/swiftlang\/sourcekit-lsp"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/swiftlang\/vscode-swift"},{"type":"text","text":" with the respective maintainers"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Cross-platform builds support with the respective workgroups and ","type":"text"},{"identifier":"https:\/\/www.swift.org\/platform-steering-group","isActive":true,"type":"reference"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Decisions about how components of the Swift toolchain itself are built and distributed fall outside the workgroup’s charter.","type":"text"}]},{"level":2,"text":"Communication","type":"heading","anchor":"Communication"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Build and Packaging workgroup uses the "},{"type":"reference","identifier":"https:\/\/forums.swift.org","isActive":true},{"type":"text","text":" for general discussions. It can also be contacted privately by messaging "},{"isActive":true,"identifier":"https:\/\/forums.swift.org\/g\/build-and-packaging-workgroup","type":"reference"},{"type":"text","text":" on the Swift Forums."}]},{"level":2,"text":"Meetings","anchor":"Meetings","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Build and Packaging Workgroup meets biweekly. Meetings take place in even numbered weeks, unless otherwise communicated in advance."}]},{"inlineContent":[{"text":"Many workgroup meetings are meant for open discussion and any Swift community member may attend by sending a message to ","type":"text"},{"type":"reference","identifier":"https:\/\/forums.swift.org\/g\/build-and-packaging-workgroup","isActive":true,"overridingTitle":"@build-and-packaging-workgroup","overridingTitleInlineContent":[{"text":"@build-and-packaging-workgroup","type":"text"}]},{"text":" beforehand to request an invite. Some meetings are reserved for private discussion by group members.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Membership","level":2,"anchor":"Membership"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Membership in the Build and Packaging Workgroup is contribution-based and expected to evolve over time. Workgroup members vote to nominate new members to the "},{"overridingTitle":"Ecosystem Steering Group","type":"reference","overridingTitleInlineContent":[{"type":"text","text":"Ecosystem Steering Group"}],"identifier":"https:\/\/www.swift.org\/ecosystem-steering-group","isActive":true},{"type":"text","text":" for approval. Nomination votes by the workgroup must be unanimous. The "},{"overridingTitle":"Ecosystem Steering Group","type":"reference","overridingTitleInlineContent":[{"type":"text","text":"Ecosystem Steering Group"}],"identifier":"https:\/\/www.swift.org\/ecosystem-steering-group","isActive":true},{"text":" designates one member of the workgroup as the chair. The chair has no special authority over the workgroup, but they are responsible for ensuring its smooth functioning, including by:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"organizing and leading regular meetings,"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"ensuring that the workgroup communicates effectively with the community, and","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"coordinating meetings between workgroup representatives and other Swift workgroups or teams when necessary."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Workgroup members will try to make a decision independently by consensus whenever possible, and will raise issues to the ","type":"text"},{"overridingTitleInlineContent":[{"type":"text","text":"Ecosystem Steering Group"}],"isActive":true,"identifier":"https:\/\/www.swift.org\/ecosystem-steering-group","type":"reference","overridingTitle":"Ecosystem Steering Group"},{"text":" when there are particular challenges with reaching consensus.","type":"text"}]},{"anchor":"Community-Participation","level":2,"type":"heading","text":"Community Participation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Everyone is invited to help improve Swift’s build and packaging experience and participate in the Workgroup’s initiatives. Here are some ways to consider participating:"}]},{"items":[{"content":[{"inlineContent":[{"text":"Discuss ideas on the ","type":"text"},{"overridingTitle":"Swift forums","overridingTitleInlineContent":[{"type":"text","text":"Swift forums"}],"isActive":true,"type":"reference","identifier":"https:\/\/forums.swift.org"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Open GitHub issues to track enhancements or report bugs in the projects governed by the workgroup, such as ","type":"text"},{"overridingTitle":"SwiftPM","overridingTitleInlineContent":[{"type":"text","text":"SwiftPM"}],"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift-package-manager"},{"text":", ","type":"text"},{"overridingTitle":"Swift Build","overridingTitleInlineContent":[{"type":"text","text":"Swift Build"}],"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift-build"},{"text":", and ","type":"text"},{"overridingTitle":"llbuild","overridingTitleInlineContent":[{"type":"text","text":"llbuild"}],"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift-llbuild"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Contribute bug fixes or enhancements to ","type":"text"},{"overridingTitle":"SwiftPM","overridingTitleInlineContent":[{"type":"text","text":"SwiftPM"}],"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift-package-manager"},{"text":", ","type":"text"},{"overridingTitle":"Swift Build","overridingTitleInlineContent":[{"type":"text","text":"Swift Build"}],"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift-build"},{"type":"text","text":", and "},{"overridingTitle":"llbuild","overridingTitleInlineContent":[{"type":"text","text":"llbuild"}],"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift-llbuild"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Provide feedback directly to the members of the workgroup directly by sending a message to "},{"overridingTitleInlineContent":[{"text":"@build-and-packaging-workgroup","type":"text"}],"isActive":true,"identifier":"https:\/\/forums.swift.org\/g\/build-and-packaging-workgroup","type":"reference","overridingTitle":"@build-and-packaging-workgroup"},{"text":" on the Forums. The workgroup chair brings outstanding issues and topics to the workgroup to discuss during regular meetings.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Join the Workgroup’s regular video meetings. Send a message to ","type":"text"},{"overridingTitleInlineContent":[{"text":"@build-and-packaging-workgroup","type":"text"}],"isActive":true,"identifier":"https:\/\/forums.swift.org\/g\/build-and-packaging-workgroup","type":"reference","overridingTitle":"@build-and-packaging-workgroup"},{"text":" to request access, since calls must be kept to a relatively small number of participants. Meetings open to the community will be announced on the Swift forums in advance.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"references":{"https://www.swift.org/platform-steering-group":{"type":"link","url":"https:\/\/www.swift.org\/platform-steering-group","identifier":"https:\/\/www.swift.org\/platform-steering-group","title":"Platform Steering Group","titleInlineContent":[{"text":"Platform Steering Group","type":"text"}]},"doc://project-operations/documentation/project-operations/documentation-workgroup":{"title":"Swift Documentation Tooling Workgroup","role":"ar
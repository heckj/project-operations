{"hierarchy":{"paths":[["doc:\/\/project-operations\/documentation\/project-operations","doc:\/\/project-operations\/documentation\/project-operations\/swift-groups"]]},"abstract":[{"type":"text","text":"The Documentation Tooling Workgroup is a steering team that helps guide the"},{"text":" ","type":"text"},{"text":"documentation experience for Swift.","type":"text"}],"metadata":{"role":"article","roleHeading":"Article","title":"Swift Documentation Tooling Workgroup"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/project-operations\/documentation\/project-operations\/documentation-workgroup"},"kind":"article","sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Documentation Tooling Workgroup will:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Define and prioritize efforts that address the documentation needs of the"},{"text":" ","type":"text"},{"text":"Swift community.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Actively guide development for documentation tooling such as Swift-DocC.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Define processes that govern contributions to Swift’s documentation"},{"text":" ","type":"text"},{"type":"text","text":"experience."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Channel feedback to ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/www.swift.org\/ecosystem-steering-group\/"},{"text":" about the needs of the Swift community.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"The current Documentation Tooling Workgroup consists of the following people:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"https:\/\/github.com\/daveverwer","isActive":true,"type":"reference"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/d-ronnqvist"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"https:\/\/github.com\/franklinsch","type":"reference"},{"type":"text","text":" (chair)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/heckj"}]}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"https:\/\/github.com\/sofiaromorales","type":"reference"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/finestructure"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"https:\/\/github.com\/QuietMisdreavus","isActive":true}]}]}]},{"type":"paragraph","inlineContent":[{"text":"We are grateful for the service of the following emeritus workgroup members:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/daniel-grumberg"}]}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/tayloraswift"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"https:\/\/github.com\/ethan-kusters","isActive":true}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/github.com\/krilnon","isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/github.com\/Kyle-Ye","isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/theMomax"}]}]}]},{"level":2,"text":"Charter","anchor":"Charter","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The main goal of the Documentation Tooling Workgroup is to deliver a great","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"documentation experience to the Swift community. To that end, the workgroup"},{"text":" ","type":"text"},{"text":"will develop tooling like Swift-DocC to support the experience it wants to","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"provide for the ecosystem and future Swift language documentation efforts. Over"},{"type":"text","text":" "},{"type":"text","text":"time, the workgroup will also help define guidelines for writing quality"},{"text":" ","type":"text"},{"text":"documentation and drive a cohesive documentation ecosystem across Swift.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In that capacity, workgroup members review proposals for changes to the"},{"type":"text","text":" "},{"text":"documentation experience, either in pull requests or ideas posted to forums,","type":"text"},{"text":" ","type":"text"},{"text":"and provide feedback in an effort to integrate these changes in a way that is","type":"text"},{"type":"text","text":" "},{"text":"consistent with the documentation experience’s goals.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Workgroup members may also initiate projects to improve different aspects of","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the Swift documentation experience, such as documentation UI\/UX"},{"type":"text","text":" "},{"type":"text","text":"design and the documentation authoring syntax."}]},{"inlineContent":[{"text":"Members of the Documentation Tooling Workgroup serve at the discretion of the Swift","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Core Team and the Swift project lead, who has the ultimate authority over the"},{"type":"text","text":" "},{"type":"text","text":"workgroup decisions."}],"type":"paragraph"},{"anchor":"Membership","type":"heading","level":2,"text":"Membership"},{"inlineContent":[{"text":"Members of the Documentation Tooling Workgroup provide steerage of Swift’s","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"documentation experience as outlined in the charter above. If you’d like to"},{"type":"text","text":" "},{"type":"text","text":"join the workgroup, please reach out to "},{"type":"codeVoice","code":"@swift-documentation-workgroup"},{"type":"text","text":" in the"},{"type":"text","text":" "},{"type":"text","text":"forums."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inactive members that do not participate for three consecutive months will be"},{"type":"text","text":" "},{"type":"text","text":"contacted to confirm their desire to stay with the group. After no activity for"},{"type":"text","text":" "},{"text":"six months, they will be removed from the group.","type":"text"}]},{"inlineContent":[{"type":"text","text":"The Core Team also selects one member of the workgroup as the chair. The chair"},{"type":"text","text":" "},{"type":"text","text":"has no special authority over the workgroup, but they are responsible for"},{"type":"text","text":" "},{"type":"text","text":"ensuring its smooth functioning, including by:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Organizing and leading regular meetings."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Ensuring that the workgroup communicates effectively with the community.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Coordinating meetings between workgroup representatives and the Core Team"},{"type":"text","text":" "},{"type":"text","text":"when issues need to be raised to the Core Team."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Workgroup members will try to make a decision independently by consensus"},{"text":" ","type":"text"},{"type":"text","text":"whenever possible, and will raise issues to the Core Team when there are particular"},{"type":"text","text":" "},{"type":"text","text":"challenges with reaching consensus on significant decisions."}],"type":"paragraph"},{"level":2,"anchor":"Communication","text":"Communication","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Documentation Tooling Workgroup communicates with the broader Swift community using"},{"text":" ","type":"text"},{"type":"text","text":"the "},{"type":"reference","identifier":"https:\/\/forums.swift.org\/c\/development\/swift-docc","isActive":true},{"text":" for","type":"text"},{"type":"text","text":" "},{"text":"general discussions about Swift-DocC. The workgroup can also be contacted","type":"text"},{"type":"text","text":" "},{"text":"privately by messaging ","type":"text"},{"code":"@swift-documentation-workgroup","type":"codeVoice"},{"type":"text","text":" on the Swift Forums."}]},{"anchor":"Community-Participation","text":"Community Participation","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Everyone is invited to participate in contributing to Swift’s documentation"},{"text":" ","type":"text"},{"type":"text","text":"experience and the Documentation Tooling Workgroup’s initiatives. If you’d like to"},{"type":"text","text":" "},{"type":"text","text":"contribute, consider:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Joining the Documentation Tooling Workgroup’s open meetings on WebEx (reach out to"},{"type":"text","text":" "},{"type":"codeVoice","code":"@swift-documentation-workgroup"},{"text":" in forums for details).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Discussing ideas in the Swift Forums, for example in the "},{"overridingTitle":"Swift-DocC forum","type":"reference","isActive":true,"overridingTitleInlineContent":[{"text":"Swift-DocC","type":"text"},{"type":"text","text":" "},{"text":"forum","type":"text"}],"identifier":"https:\/\/forums.swift.org\/c\/development\/swift-docc"},{"text":" for","type":"text"},{"type":"text","text":" "},{"text":"Swift-DocC–related ideas.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Opening issues to track enhancements and bugs for the projects governed by the Documentation Tooling Workgroup:","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/swiftlang\/swift-docc\/issues","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"https:\/\/github.com\/swiftlang\/swift-book\/issues","type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Participating in the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/www.swift.org\/mentorship"},{"text":".","type":"text"}]}]}],"type":"unorderedList"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/project-operations\/documentation\/project-operations\/android-workgroup","doc:\/\/project-operations\/documentation\/project-operations\/build-and-packaging-workgroup","doc:\/\/project-operations\/documentation\/project-operations\/cxx-interop-workgroup","doc:\/\/project-operations\/documentation\/project-operations\/contributor-experience-workgroup","doc:\/\/project-operations\/documentation\/project-operations\/foundation-workgroup","doc:\/\/project-operations\/documentation\/project-operations\/server-workgroup","doc:\/\/project-operations\/documentation\/project-operations\/testing-workgroup","doc:\/\/project-operations\/documentation\/project-operations\/website-workgroup","doc:\/\/project-operations\/documentation\/project-operations\/windows-workgroup"],"generated":true,"anchor":"Workgroups","title":"Workgroups"}],"references":{"https://github.com/swiftlang/swift-docc/issues":{"type":"link","
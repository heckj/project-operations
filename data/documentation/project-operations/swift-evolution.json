{"sections":[],"kind":"article","metadata":{"roleHeading":"Article","role":"article","title":"Swift Evolution"},"identifier":{"url":"doc:\/\/project-operations\/documentation\/project-operations\/swift-evolution","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/project-operations\/documentation\/project-operations\/forums","doc:\/\/project-operations\/documentation\/project-operations\/reporting-bugs","doc:\/\/project-operations\/documentation\/project-operations\/triaging-bugs","doc:\/\/project-operations\/documentation\/project-operations\/good-first-issues","doc:\/\/project-operations\/documentation\/project-operations\/contributing-code","doc:\/\/project-operations\/documentation\/project-operations\/contributor-ladder"],"generated":true,"anchor":"Communication","title":"Communication"}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Shaping the future of Swift is a community effort that anyone can participate in via the "},{"type":"reference","identifier":"forums.md#swift-evolution","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The "},{"type":"reference","identifier":"https:\/\/github.com\/swiftlang\/swift-evolution\/blob\/main\/process.md","isActive":true},{"type":"text","text":" covers all changes to the Swift language and the public interface of the Swift standard library, including new language features and APIs, changes to existing language features or APIs, removal of existing features, and so on."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"See the "},{"type":"reference","identifier":"https:\/\/www.swift.org\/swift-evolution","isActive":true},{"type":"text","text":" for current and upcoming proposal reviews."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/project-operations\/documentation\/project-operations","doc:\/\/project-operations\/documentation\/project-operations\/contributing-to-swift"]]},"abstract":[{"text":"Understand the process the Swift project uses to evolve the language.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://project-operations/documentation/project-operations":{"role":"collection","url":"\/documentation\/project-operations","title":"🏛️🤝 Swift Project Operations 🤝🏛️","identifier":"doc:\/\/project-operations\/documentation\/project-operations","abstract":[{"text":"This repository houses processes, policies, and procedures that relate to the operation of the Swift project.","type":"text"}],"kind":"article","type":"topic"},"doc://project-operations/documentation/project-operations/forums":{"role":"article","url":"\/documentation\/project-operations\/forums","title":"Swift Forums","identifier":"doc:\/\/project-operations\/documentation\/project-operations\/forums","abstract":[{"text":"Learn about the community channels for the Swift project.","type":"text"}],"kind":"article","type":"topic"},"doc://project-operations/documentation/project-operations/reporting-bugs":{"abstract":[{"type":"text","text":"Reporting bugs is a great way for anyone to help improve Swift. The open source Swift project uses GitHub Issues for tracking bugs."}],"url":"\/documentation\/project-operations\/reporting-bugs","type":"topic","kind":"article","role":"article","title":"Reporting Bugs","identifier":"doc:\/\/project-operations\/documentation\/project-operations\/reporting-bugs"},"doc://project-operations/documentation/project-operations/good-first-issues":{"abstract":[{"type":"text","text":"Understand identifying introductory issues that are good starting points for developers new to contributing to Swift."}],"kind":"article","url":"\/documentation\/project-operations\/good-first-issues","type":"topic","role":"article","title":"Good First Issues","identifier":"doc:\/\/project-operations\/documentation\/project-operations\/good-first-issues"},"https://github.com/swiftlang/swift-evolution/blob/main/process.md":{"type":"link","url":"https:\/\/github.com\/swiftlang\/swift-evolution\/blob\/main\/process.md","identifier":"https:\/\/github.com\/swiftlang\/swift-evolution\/blob\/main\/process.md","title":"Swift evolution process","titleInlineContent":[{"text":"Swift evolution process","type":"text"}]},"doc://project-operations/documentation/project-operations/contributing-to-swift":{"role":"collectionGroup","url":"\/documentation\/project-operations\/contributing-to-swift","title":"Contributing to Swift","identifier":"doc:\/\/project-operations\/documentation\/project-operations\/contributing-to-swift","abstract":[{"text":"The Swift.org community has the singular goal of making the world’s best general purpose programming language. Collectively we will develop the language in the open, with contributions from anyone who wishes to participate. This guideline document describes how the Swift community is organized so that we can work together to add amazing new capabilities to Swift, and make it available to even more developers across more platforms.","type":"text"}],"kind":"article","type":"topic"},"https://www.swift.org/swift-evolution":{"type":"link","url":"https:\/\/www.swift.org\/swift-evolution","identifier":"https:\/\/www.swift.org\/swift-evolution","title":"Swift evolution review schedule","titleInlineContent":[{"text":"Swift evolution review schedule","type":"text"}]},"forums.md#swift-evolution":{"title":"Evolution section of the Swift forums","titleInlineContent":[{"type":"text","text":"Evolution section of the Swift forums"}],"type":"link","identifier":"forums.md#swift-evolution","url":"forums.md#swift-evolution"},"doc://project-operations/documentation/project-operations/contributing-code":{"abstract":[],"url":"\/documentation\/project-operations\/contributing-code","type":"topic","kind":"article","role":"article","title":"Contributing Code","identifier":"doc:\/\/project-operations\/documentation\/project-operations\/contributing-code"},"doc://project-operations/documentation/project-operations/triaging-bugs":{"abstract":[{"text":"Reporting bugs is an important part of improving software.","type":"text"},{"type":"text","text":" "},{"text":"Nearly as important is triaging those bugs to ensure that they are reproducible, small, and unique.","type":"text"}],"kind":"article","type":"topic","url":"\/documentation\/project-operations\/triaging-bugs","role":"article","title":"Triaging Bugs","identifier":"doc:\/\/project-operations\/documentation\/project-operations\/triaging-bugs"},"doc://project-operations/documentation/project-operations/contributor-ladder":{"role":"article","url":"\/documentation\/project-operations\/contributor-ladder","title":"Contributor Ladder","identifier":"doc:\/\/project-operations\/documentation\/project-operations\/contributor-ladder","abstract":[{"type":"text","text":"This contributor ladder defines the roles you might gain while contributing to Swift on GitHub. Each role has privileges associated, which requires building trust with the community of contributors. We recognize there are many different types of contributors to Swift and we appreciate every single one! Everyone who has participated in the open source Swift project is a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Contributor"}]},{"type":"text","text":": This can be by writing code, answering questions on the forums, reporting or triaging bugs, or participating in the Swift evolution process."}],"kind":"article","type":"topic"}}}